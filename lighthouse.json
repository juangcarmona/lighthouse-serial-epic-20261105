{
  "$schema": "./node_modules/@juangcarmona/lighthouse/assets/schemas/lighthouse-manifest.schema.json",
  "schemaVersion": 1,
  "baseline": "0.1.0",
  "product": "Serial epic qualification",
  "application": {
    "shape": "unknown",
    "stacks": []
  },
  "profiles": [],
  "integrations": {
    "productShape": null,
    "arcShape": null
  },
  "packages": {
    "sdlc": {
      "name": "@juangcarmona/lighthouse-sdlc",
      "version": "0.20.5"
    }
  },
  "managed": [
    "LIGHTHOUSE.md",
    "scripts/lighthouse-guard.mjs",
    ".husky/commit-msg",
    ".husky/pre-push",
    ".github/workflows/lighthouse.yml",
    ".lighthouse/sdlc.json",
    ".agents/skills/lighthouse-init/SKILL.md",
    ".lighthouse/upgrade.json",
    ".lighthouse/commands.json"
  ],
  "repository": {
    "layout": [
      "src",
      "docs",
      "infra",
      "scripts"
    ],
    "publicSite": {
      "enabled": true
    },
    "conventions": {
      "commits": "conventional",
      "branchPattern": "^(?:(feat|fix|docs|refactor|test|chore|build|ci|perf|revert)/[1-9]\\d*-[a-z0-9]+(?:-[a-z0-9]+)*|(?:codex|lighthouse)/[a-z0-9][a-z0-9/-]*)$"
    }
  }
}
